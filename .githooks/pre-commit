#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
git diff --cached --check

mapfile -t dockerfiles < <(git diff --cached --name-only --diff-filter=ACMR -- '*/Dockerfile')
if ((${#dockerfiles[@]})); then
  hadolint --failure-threshold error "${dockerfiles[@]}"
fi
mapfile -t shell_files < <(git diff --cached --name-only --diff-filter=ACMR -- '*/root/defaults/startwm.sh')
if ((${#shell_files[@]})); then
  shellcheck "${shell_files[@]}"
fi
if ! git diff --cached --quiet -- '.github/workflows/*.yml' '.github/workflows/*.yaml'; then
  actionlint
  zizmor --offline --min-severity medium --min-confidence medium .github
fi
